# API key for API protection (REQUIRED).
# The server refuses every request until this is set - there is no
# unauthenticated/open mode.
API_KEY=

# Port for API server (default: 11292)
API_PORT=

# Default operating mode
# true - automatic search for Dokploy container
# false - manual mode (requires specifying container_id in the request)
AUTO_MODE=

# Network exposure (default: false = localhost-only).
# false - bind to 127.0.0.1 only; nothing beyond this host can reach the API
#         directly. This is the secure default - reach it via SSH tunnel,
#         a VPN/tailnet, or a TLS-terminating reverse proxy on this host.
# true  - bind to 0.0.0.0. This API has no TLS of its own, so only enable
#         this if it sits behind a reverse proxy (e.g. Traefik, which
#         Dokploy itself already runs) that terminates TLS and forwards to
#         127.0.0.1:<API_PORT> - never expose plain HTTP to an untrusted
#         network. install.sh only opens the host firewall for this port
#         when PUBLIC_BIND is also true.
PUBLIC_BIND=false

# Log verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Notifications Telegram
TG_TOKEN=
TG_ADMIN=

# Automatic updates check
# true - automatically install new updates when available
# false - only send Telegram notification about new updates (manual installation required)
AUTOMATICALLY_CHECK_FOR_NEW_UPDATES=false
